{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.nextgentechdev.com/api/:path*"
    },
    {
      "source": "/admin/admin.css",
      "destination": "/admin.css"
    },
    {
      "source": "/admin/admin.js",
      "destination": "/admin.js"
    },
    {
      "source": "/admin/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/admin/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/ai-automation-roi-calculator",
      "destination": "/ai-automation-roi-calculator.html"
    },
    {
      "source": "/ai-automation",
      "destination": "/ai-automation.html"
    },
    {
      "source": "/api-cloud-development",
      "destination": "/api-cloud-development.html"
    },
    {
      "source": "/llm-agent-development",
      "destination": "/llm-agent-development.html"
    },
    {
      "source": "/mt5-ea-requirements-generator",
      "destination": "/mt5-ea-requirements-generator.html"
    },
    {
      "source": "/mt5-position-size-calculator",
      "destination": "/mt5-position-size-calculator.html"
    },
    {
      "source": "/mt5-telegram-copy-trading-bot",
      "destination": "/mt5-telegram-copy-trading-bot.html"
    },
    {
      "source": "/pine-script-to-mt5-automation",
      "destination": "/pine-script-to-mt5-automation.html"
    },
    {
      "source": "/portfolio",
      "destination": "/portfolio.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/resources",
      "destination": "/resources.html"
    },
    {
      "source": "/services/ai-automation",
      "destination": "/services/ai-automation.html"
    },
    {
      "source": "/services/cloud-support",
      "destination": "/services/cloud-support.html"
    },
    {
      "source": "/services/software-apis",
      "destination": "/services/software-apis.html"
    },
    {
      "source": "/services/trading-bots",
      "destination": "/services/trading-bots.html"
    },
    {
      "source": "/services/websites",
      "destination": "/services/websites.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/trading-bot-development",
      "destination": "/trading-bot-development.html"
    },
    {
      "source": "/web-app-development",
      "destination": "/web-app-development.html"
    },
    {
      "source": "/xauusd-trading-bot-development",
      "destination": "/xauusd-trading-bot-development.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https:; media-src 'self' blob:; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/(.*).(jpg|jpeg|png|webp|avif|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
