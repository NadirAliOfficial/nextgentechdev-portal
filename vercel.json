{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://amended-higher-regard-circus.trycloudflare.com/api/:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/admin.css", "destination": "/admin.css" },
    { "source": "/admin/admin.js", "destination": "/admin.js" },
    { "source": "/admin/manifest.json", "destination": "/manifest.json" }
  ]
}
